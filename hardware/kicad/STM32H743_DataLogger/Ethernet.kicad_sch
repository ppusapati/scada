  ;; ============================================================
  ;; TEXT ANNOTATIONS
  ;; ============================================================
  (text "ETHERNET 10/100 DESIGN\n\nPHY: LAN8742A-CZ-TR (QFN-24)\n- RMII interface to STM32H743\n- 25MHz REF_CLK from HSE crystal\n- Internal 1.2V regulator\n- Auto-MDIX support\n- IEEE 802.3 / 802.3u compliant\n\nMagnetics: J0011D21BNL (RJ45 + integrated magnetics)\n- 10/100 Base-TX\n- Link/Activity LEDs integrated\n- Shielded connector\n\nESD: PESD5V0S2BT on all data lines\nTermination: 49.9R series on TX+/TX-"
    (exclude_from_sim no)
    (at 25.4 25.4 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid "ETH-TEXT-0001")
