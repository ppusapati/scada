    (date "2026-03-19")
    (rev "1.0 MFG")
    (company "P9E Microsystems Pvt Ltd")
    (comment 1 "4-Layer PCB, 1.6mm FR-4 TG170, ENIG finish")
    (comment 2 "160mm x 100mm Eurocard - MANUFACTURING RELEASE")
    (comment 3 "IPC Class 2, Lead-free RoHS, SAC305")
    (comment 4 "Conformal Coat: HumiSeal 1B73 MIL-I-46058C")
  )

  ;; ============================================================
  ;; LAYER STACKUP - 4 Layer Industrial Grade
  ;; ============================================================
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND Plane")
    (2 "In2.Cu" signal "Power Plane")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
