  ;; ============================================================
  ;; STITCHING VIAS - GND connection between layers
  ;; ============================================================
  ;; Perimeter stitching vias (every ~10mm around board edge)
  ;; Bottom edge
  ;; Left/Right edges
  ;; MCU area decoupling vias

  ;; ============================================================
  ;; COPPER ZONE FILLS - 4 layer stackup
  ;; ============================================================
  ;; F.Cu - GND pour
  (zone (net 1) (net_name "GND") (layer "F.Cu") (uuid "MFG-ZONE-F-GND")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 0 26) (xy 63 26) (xy 63 0) (xy 160 0) (xy 160 100) (xy 0 100)
    ))
  )
  ;; In1.Cu - Full GND plane
  (zone (net 1) (net_name "GND") (layer "In1.Cu") (uuid "MFG-ZONE-IN1-GND")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 0 26) (xy 63 26) (xy 63 0) (xy 160 0) (xy 160 100) (xy 0 100)
    ))
  )
  ;; In2.Cu - Split power plane (+3V3 primary, +5V secondary)
  (zone (net 2) (net_name "+3V3") (layer "In2.Cu") (uuid "MFG-ZONE-IN2-3V3") (priority 1)
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 0 26) (xy 63 26) (xy 63 0) (xy 160 0) (xy 160 100) (xy 0 100)
    ))
  )
  ;; B.Cu - GND pour
  (zone (net 1) (net_name "GND") (layer "B.Cu") (uuid "MFG-ZONE-B-GND")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 0 26) (xy 63 26) (xy 63 0) (xy 160 0) (xy 160 100) (xy 0 100)
    ))
  )



  ;; ============================================================
  ;; ISOLATED FIELD-SIDE POURS (floating, inside the notch)
  ;; RS485 pour -> main copper: 8mm left, 7mm below.
  ;; CAN   pour -> main copper: 4mm right, 7mm below.  RS485 <-> CAN: 4mm.
  ;; ============================================================
  (zone (net 135) (net_name "RS485_ISO_GND") (layer "F.Cu") (uuid "MFG-ZONE-RS485-F")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 8 1) (xy 34 1) (xy 34 19) (xy 8 19)
    ))
  )
  (zone (net 135) (net_name "RS485_ISO_GND") (layer "B.Cu") (uuid "MFG-ZONE-RS485-B")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 8 1) (xy 34 1) (xy 34 19) (xy 8 19)
    ))
  )
  (zone (net 139) (net_name "CAN_ISO_GND") (layer "F.Cu") (uuid "MFG-ZONE-CAN-F")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 38 1) (xy 59 1) (xy 59 19) (xy 38 19)
    ))
  )
  (zone (net 139) (net_name "CAN_ISO_GND") (layer "B.Cu") (uuid "MFG-ZONE-CAN-B")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 38 1) (xy 59 1) (xy 59 19) (xy 38 19)
    ))
  )

  ;; Isolation slots (milled) under the four packages that cross the barrier
  (gr_line (start 11.5 21.4) (end 21.5 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U40-0"))
  (gr_line (start 21.5 21.4) (end 21.5 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U40-1"))
  (gr_line (start 21.5 22.6) (end 11.5 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U40-2"))
  (gr_line (start 11.5 22.6) (end 11.5 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U40-3"))
  (gr_line (start 23.0 21.4) (end 32.6 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U42-0"))
  (gr_line (start 32.6 21.4) (end 32.6 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U42-1"))
  (gr_line (start 32.6 22.6) (end 23.0 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U42-2"))
  (gr_line (start 23.0 22.6) (end 23.0 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U42-3"))
  (gr_line (start 37.5 21.4) (end 47.5 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U41-0"))
  (gr_line (start 47.5 21.4) (end 47.5 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U41-1"))
  (gr_line (start 47.5 22.6) (end 37.5 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U41-2"))
  (gr_line (start 37.5 22.6) (end 37.5 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U41-3"))
  (gr_line (start 49.0 21.4) (end 58.6 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U43-0"))
  (gr_line (start 58.6 21.4) (end 58.6 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U43-1"))
  (gr_line (start 58.6 22.6) (end 49.0 22.6) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U43-2"))
  (gr_line (start 49.0 22.6) (end 49.0 21.4) (stroke (width 0.1) (type default)) (layer "Edge.Cuts") (uuid "MFG-SLOT-U43-3"))

  ;; No copper may bridge the TLP293 barrier on any layer
  (zone (net 0) (net_name "") (layers "F.Cu" "In1.Cu" "In2.Cu" "B.Cu") (uuid "MFG-ZONE-DI-KEEPOUT") (name "DI_OPTO_BARRIER")
    (hatch edge 0.5)
    (connect_pads (clearance 0))
    (min_thickness 0.25)
    (keepout (tracks not_allowed) (vias not_allowed) (pads allowed) (copperpour not_allowed) (footprints allowed))
    (fill (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts
      (xy 64 19.3) (xy 111 19.3) (xy 111 20.7) (xy 64 20.7)
    ))
  )

  ;; SPI4 bus: MCU to W5500 (controlled impedance, 0.15mm width)

  ;; Ethernet diff pairs: W5500 to ferrite beads (0.15mm, matched length)

  ;; Power: +3V3 distribution backbone (0.5mm wide)

  ;; RS485 diff pair: ISO3082 to connector

  ;; CAN diff pair: ISO1042 to connector

  ;; SDMMC1 bus: MCU to microSD

  ;; USB: MCU to J11 (0.15mm controlled impedance)

)
