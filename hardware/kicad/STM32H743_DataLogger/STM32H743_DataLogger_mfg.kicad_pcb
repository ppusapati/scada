  ;; ============================================================
  ;; LAYER STACKUP - 4 Layer Industrial Grade
  ;; ============================================================
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND Plane")
    (2 "In2.Cu" signal "Power Plane")
