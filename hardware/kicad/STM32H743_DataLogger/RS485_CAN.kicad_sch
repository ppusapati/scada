  ;; ============================================================
  ;; TEXT ANNOTATIONS
  ;; ============================================================
  (text "RS485 & CAN BUS DESIGN\n\nRS485 (Modbus RTU):\n- ISO3082DWR isolated transceiver (5kVrms)\n- Half-duplex, auto DE/RE control\n- 120R termination (jumper selectable)\n- PESD2CAN ESD protection\n- Baud rate up to 20Mbps\n\nCAN FD Bus:\n- ISO1042BQDWRQ1 isolated transceiver (5kVrms)\n- CAN FD support up to 5Mbps\n- 120R termination (jumper selectable)\n- PESD2CAN ESD protection\n- STM32H743 FDCAN1 peripheral"
    (exclude_from_sim no)
    (at 25.4 25.4 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid "COM-TEXT-0001")
  )
