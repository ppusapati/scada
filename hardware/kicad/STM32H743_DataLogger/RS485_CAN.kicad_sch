  ;; ============================================================
  ;; ISOLATED BUS-SIDE SUPPLIES
  ;; The ISO3082 / ISO1042 bus sides need their own floating 5V rail; without
  ;; these converters RS485_ISO_VCC / CAN_ISO_VCC are undriven and the galvanic
  ;; isolation is defeated.  NXJ1S is rated 5.2kVDC to match the transceivers.
  ;; ============================================================
  (symbol (lib_id "Converter_DCDC:NXJ1S0505MC-R13") (at 69.85 165.1) (unit 1)
