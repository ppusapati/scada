  ;; ============================================================
  ;; TEXT ANNOTATIONS
  ;; ============================================================
  (text "STORAGE SUBSYSTEM\n\nmicroSD Card (SDMMC1 4-bit):\n- Molex push-push connector with card detect\n- 47k pull-ups on data lines\n- Up to 50MHz high-speed mode\n- For continuous data logging\n\nExternal Flash W25Q64JV (SPI3):\n- 64Mbit (8MB) NOR Flash\n- Quad SPI capable\n- For firmware OTA updates and data backup\n- 100k erase cycles\n\nEEPROM AT24C256C (I2C1):\n- 256Kbit (32KB)\n- For calibration data and configuration\n- 1M write cycles\n- 4.7k I2C pull-ups"
    (exclude_from_sim no)
