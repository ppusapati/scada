  ;; Top layer GND pour
  (zone
    (net 0)
    (net_name "GND")
    (layer "F.Cu")
    (uuid "PCB-ZONE-F-GND")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.2)
    (filled_areas_thickness no)
    (fill yes (thermal_gap 0.3) (thermal_bridge_width 0.3))
    (polygon (pts
      (xy 1 1) (xy 159 1) (xy 159 99) (xy 1 99)
    ))
  )

