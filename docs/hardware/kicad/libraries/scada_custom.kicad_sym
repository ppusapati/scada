  ;; ── 4-20mA Input Conditioning Block ──
  ;; Represents one complete 4-20mA channel conditioning circuit
  ;; (TVS + R_filt + C_filt + R_shunt + clamp diodes)
  (symbol "SCADA_420mA_Input"
    (in_bom yes)
    (on_board yes)
    (property "Reference" "X"
      (at 0 8.89 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Value" "420mA_CH"
      (at 0 -8.89 0)
      (effects (font (size 1.27 1.27)))
    )
    (property "Description" "4-20mA input conditioning: TVS, RC filter, 250R shunt, Schottky clamps")
    (property "ki_keywords" "4-20mA current loop analog input conditioning")
    (symbol "SCADA_420mA_Input_0_1"
      (rectangle
        (start -7.62 7.62)
        (end 7.62 -7.62)
        (stroke (width 0.254) (type default))
        (fill (type background))
      )
      (text "4-20mA" (at 0 3.81 0)
